NODE_ENV=dev

APP_PORT=3000
HASH_SALT=10
CORS_ORIGIN=http://localhost:8080

DATABASE_DRIVER=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=db
DATABASE_USERNAME=db
DATABASE_PASSWORD=postgres

JWT_ACCESS_SECRET=super-secret-access-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_EMAIL=admin@skillswap.com
ADMIN_PASSWORD=Admin1234!

# =========================
# MAIL CONFIG
# =========================
# 465 = SSL (secure=true), 587 = STARTTLS (secure=false)
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_email@yandex.ru
MAIL_PASSWORD=your_app_password
MAIL_FROM="No Reply" <noreply@example.com>
MAIL_MAX_RETRIES=3
MAIL_RETRY_DELAY_MS=1000
